# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Catálogo Tom Hanks
# Copie para .env e preencha com valores reais ANTES de executar.
# No Portainer: preencha na seção *Environment variables* da stack.
# NUNCA versione o .env com valores reais.
# ══════════════════════════════════════════════════════════════════════════════

# ── Banco de dados MariaDB (OBRIGATÓRIO) ──────────────────────────────────────
DB_HOST=troque-pelo-host-do-banco
DB_PORT=3306
DB_USER=troque-pelo-usuario-do-banco
DB_PASSWORD=troque-pela-senha-do-banco
DB_NAME=troque-pelo-nome-do-banco
DB_DRIVER=mysql+mysqlconnector

# ── Catálogo (backend Flask) — OBRIGATÓRIO ────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=troque-por-chave-aleatoria-longa

PORT=8080
TMDB_API_KEY=troque-pela-sua-chave-da-tmdb
TMDB_LANGUAGE=pt-BR

CORS_ORIGINS=http://localhost:8080
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0

# ── Auth-service — OBRIGATÓRIO ────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=troque-por-chave-aleatoria-longa

AUTH_PORT=3000
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@seudominio.com
AUTH_ADMIN_PASSWORD=troque-pela-senha-do-admin-inicial

# ── Token interno entre serviços — OBRIGATÓRIO ────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_TOKEN=troque-por-token-aleatorio-longo

# ── MinIO Object Storage — OBRIGATÓRIO ───────────────────────────────────────
MINIO_ROOT_USER=troque-pelo-usuario-minio
MINIO_ROOT_PASSWORD=troque-pela-senha-minio
MINIO_ACCESS_KEY=troque-pelo-usuario-minio
MINIO_SECRET_KEY=troque-pela-senha-minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=tomhanks-avatars
MINIO_PUBLIC_URL=http://localhost:9000/tomhanks-avatars

# ── Google OAuth 2.0 — opcional (sem Google OAuth, botão não aparece) ──────────
# 1. Acesse: https://console.cloud.google.com → APIs → Credenciais → OAuth 2.0
# 2. Crie um "ID do cliente OAuth" do tipo "Aplicativo Web"
# 3. Adicione como URI de redirecionamento autorizado: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=troque-pelo-client-id-do-google
GOOGLE_CLIENT_SECRET=troque-pelo-client-secret-do-google
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Stripe — opcional (sem Stripe, pagamentos desabilitados) ──────────────────
# NUNCA use chaves de produção em desenvolvimento. Use sempre sk_test_... / pk_test_...
# 1. Acesse: https://dashboard.stripe.com/test/apikeys
# 2. Copie a "Secret key" e a "Publishable key" de TESTE
STRIPE_SECRET_KEY=troque-pela-stripe-secret-key-de-teste
STRIPE_PUBLISHABLE_KEY=troque-pela-stripe-publishable-key-de-teste

# Webhook: registre em https://dashboard.stripe.com/test/webhooks
# Eventos: checkout.session.completed, customer.subscription.updated,
#          customer.subscription.deleted, invoice.payment_failed
# Para testar localmente: stripe listen --forward-to localhost:5000/webhook
# (e copie o webhook signing secret exibido pelo CLI)
STRIPE_WEBHOOK_SECRET=troque-pelo-webhook-signing-secret-do-stripe

# ID do preço do produto premium (criado via API/dashboard):
# Produto: prod_VPedk3CYRuuQv8 — "Tom Hanks Premium" (R$ 9,90/mês)
# https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID=price_1UOpKWRvhezfVKAcZ248k8l3

STRIPE_SUCCESS_URL=http://localhost:8080/?payment=success
STRIPE_CANCEL_URL=http://localhost:8080/?payment=cancel
ENTITLEMENT_CACHE_TTL=300

# URL do frontend (usada em redirecionamentos de OAuth e portal Stripe)
FRONTEND_URL=http://localhost:8080

# ── E-mail / SMTP — opcional (sem SMTP, reset de senha não envia e-mail) ──────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=troque-pelo-seu-usuario-mailtrap
SMTP_PASS=troque-pela-sua-senha-mailtrap
SMTP_FROM=noreply@tomhanks.local
# Use 1 apenas em desenvolvimento para exibir o link de reset no log.
PASSWORD_RESET_EXPOSE_LINK=0

# ── Grafana — opcional (padrão "admin" apenas para desenvolvimento) ────────────
GRAFANA_ADMIN_PASSWORD=troque-pela-senha-grafana

# ── Deploy (GitHub Actions → Portainer) ──────────────────────────────────────
# Configure no GitHub: Settings → Secrets → Actions
# PORTAINER_WEBHOOK_URL=https://portainer.seudominio.com/api/webhooks/<uuid>
# DEPLOY_HEALTH_URL=https://seudominio.com/api/health
