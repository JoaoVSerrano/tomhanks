# ── Catálogo (backend Flask) ──────────────────────────────────────
FLASK_SECRET_KEY=change-me
PORT=8080
TMDB_API_KEY=your_tmdb_developer_key
TMDB_LANGUAGE=pt-BR

DB_DRIVER=mysql+mysqlconnector
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tomhanks_user
DB_PASSWORD=change-me
DB_NAME=tomhanks

CORS_ORIGINS=http://localhost:8080
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0

# URL interna do auth-service (automática no Docker; mude só para dev local)
AUTH_SERVICE_URL=http://auth-service:3000
# Token secreto compartilhado entre catálogo e auth-service
INTERNAL_TOKEN=internal-change-me

# ── Auth-service ──────────────────────────────────────────────────
AUTH_SECRET_KEY=auth-change-me
AUTH_PORT=3000
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-me-admin

# E-mail (Mailtrap para dev, Brevo para produção)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@tomhanks.local
# Use 1 apenas em desenvolvimento para mostrar o link de reset na tela.
PASSWORD_RESET_EXPOSE_LINK=0

# URL do frontend para o link de reset de senha
FRONTEND_URL=http://localhost:8080
